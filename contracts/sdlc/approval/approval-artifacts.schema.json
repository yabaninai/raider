{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raider.dev/contracts/sdlc/approval/approval-artifacts.schema.json",
  "title": "Additive SDLC approval request and separate decision file",
  "oneOf": [
    {
      "title": "Approval request carrier",
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "type", "id", "data"],
      "properties": {
        "schemaVersion": {"const": 2},
        "type": {"const": "approval-request"},
        "id": {"type": "string", "minLength": 1},
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["checkpointId", "candidateDigest", "expiresAt"],
          "properties": {
            "checkpointId": {"type": "string", "minLength": 1},
            "candidateDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "expiresAt": {"type": "string", "format": "date-time"}
          }
        }
      }
    },
    {
      "title": "Separate human decision file",
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "checkpointId", "candidateDigest", "expiresAt", "approved"],
      "properties": {
        "schemaVersion": {"const": 2},
        "checkpointId": {"type": "string", "minLength": 1},
        "candidateDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "expiresAt": {"type": "string", "format": "date-time"},
        "approved": {"type": "boolean"}
      }
    }
  ]
}
