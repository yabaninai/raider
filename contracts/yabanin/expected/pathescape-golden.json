{
  "schema": "raider.contracts.yabanin.pathescape/1",
  "algorithm": "Go net/url PathEscape, i.e. escape(s, encodePathSegment): byte-wise UTF-8, uppercase hex. ASCII alphanumerics and -_.~ pass through; among the reserved characters $&+,:;=?@ only / ; , ? are escaped; every other byte becomes %XX.",
  "repin_rule": "These expectations are pinned from the Go standard library (net/url). Re-derive them only by running PathEscape from a supported Go toolchain and recording the output here; never hand-edit an escape value without that evidence.",
  "cases": [
    { "name": "empty", "input": "", "expected": "" },
    { "name": "plain-word", "input": "raider", "expected": "raider" },
    { "name": "alnum-mixed-case", "input": "RaiDer0123", "expected": "RaiDer0123" },
    { "name": "unreserved-marks", "input": "-_.~", "expected": "-_.~" },
    { "name": "space", "input": "a b", "expected": "a%20b" },
    { "name": "plus-not-escaped", "input": "a+b", "expected": "a+b" },
    { "name": "slash", "input": "a/b", "expected": "a%2Fb" },
    { "name": "comma", "input": "a,b", "expected": "a%2Cb" },
    { "name": "semicolon", "input": "a;b", "expected": "a%3Bb" },
    { "name": "equals", "input": "a=b", "expected": "a=b" },
    { "name": "colon", "input": "a:b", "expected": "a:b" },
    { "name": "ampersand", "input": "a&b", "expected": "a&b" },
    { "name": "dollar", "input": "a$b", "expected": "a$b" },
    { "name": "at-sign", "input": "a@b", "expected": "a@b" },
    { "name": "question", "input": "a?b", "expected": "a%3Fb" },
    { "name": "percent", "input": "100%", "expected": "100%25" },
    { "name": "hash", "input": "a#b", "expected": "a%23b" },
    { "name": "double-quote", "input": "a\"b", "expected": "a%22b" },
    { "name": "single-quote", "input": "a'b", "expected": "a%27b" },
    { "name": "square-brackets", "input": "[rai]", "expected": "%5Brai%5D" },
    { "name": "parentheses", "input": "(rai)", "expected": "%28rai%29" },
    { "name": "asterisk", "input": "*", "expected": "%2A" },
    { "name": "exclamation", "input": "!", "expected": "%21" },
    { "name": "tab", "input": "a\tb", "expected": "a%09b" },
    { "name": "newline", "input": "a\nb", "expected": "a%0Ab" },
    { "name": "latin-small-e-acute", "input": "café", "expected": "caf%C3%A9" },
    { "name": "check-mark", "input": "✓", "expected": "%E2%9C%93" },
    { "name": "cjk", "input": "日本", "expected": "%E6%97%A5%E6%9C%AC" },
    { "name": "mathematical-double-struck-x", "input": "𝕏", "expected": "%F0%9D%95%8F" },
    { "name": "inverted-exclamation", "input": "¡", "expected": "%C2%A1" },
    { "name": "latin-small-y-diaeresis", "input": "ÿ", "expected": "%C3%BF" },
    { "name": "composite", "input": "root/1, attempt=a b", "expected": "root%2F1%2C%20attempt=a%20b" }
  ]
}
