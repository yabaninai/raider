{
  "schema": "raider.contracts.yabanin.labels/1",
  "limits": {
    "max_per_source": 20,
    "max_effective": 32,
    "max_value_length_bytes": 128,
    "reserved_key_prefix": "yabanin.",
    "client_key_max_length": 64
  },
  "limits_rule": "Value length is measured in UTF-8 bytes (matching Go len() on the wire), not characters. Keys are sorted lexicographically in the rendered header. Per-source caps apply per provenance (wrapper and client each admit up to max_per_source); the merged header admits up to max_effective pairs, dropping client labels in insertion order once full.",
  "render_cases": [
    {
      "name": "canonical-sorted",
      "client_labels": [
        { "key": "task", "value": "RAI-021" },
        { "key": "harness", "value": "raider" },
        { "key": "raider.root", "value": "r-1" },
        { "key": "git.repo", "value": "yabaninai/raider" },
        { "key": "raider.attempt", "value": "a-1" },
        { "key": "raider.job", "value": "j-7" }
      ],
      "expected_header": "git.repo=yabaninai%2Fraider,harness=raider,raider.attempt=a-1,raider.job=j-7,raider.root=r-1,task=RAI-021",
      "expected_accepted": [
        { "key": "git.repo", "value": "yabaninai/raider" },
        { "key": "harness", "value": "raider" },
        { "key": "raider.attempt", "value": "a-1" },
        { "key": "raider.job", "value": "j-7" },
        { "key": "raider.root", "value": "r-1" },
        { "key": "task", "value": "RAI-021" }
      ],
      "expected_dropped": []
    },
    {
      "name": "escape-values",
      "client_labels": [
        { "key": "raider.workflow", "value": "audit workflow" },
        { "key": "git.ref", "value": "feature/✓" },
        { "key": "raider.note", "value": "a+b,c/d" }
      ],
      "expected_header": "git.ref=feature%2F%E2%9C%93,raider.note=a+b%2Cc%2Fd,raider.workflow=audit%20workflow",
      "expected_accepted": [
        { "key": "git.ref", "value": "feature/✓" },
        { "key": "raider.note", "value": "a+b,c/d" },
        { "key": "raider.workflow", "value": "audit workflow" }
      ],
      "expected_dropped": []
    },
