  "parse_cases": [
    {
      "name": "percent-encoded",
      "raw": "task=CI%204311,raider.root=r%2F1",
      "expected_pairs": [
        { "key": "raider.root", "value": "r/1" },
        { "key": "task", "value": "CI 4311" }
      ]
    },
    {
      "name": "escaped-comma",
      "raw": "note=a%2Cb,task=T",
      "expected_pairs": [
        { "key": "note", "value": "a,b" },
        { "key": "task", "value": "T" }
      ]
    },
    {
      "name": "empty",
      "raw": "",
      "expected_pairs": []
    },
