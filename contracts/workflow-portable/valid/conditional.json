{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://raider.invalid/contracts/workflow-portable/workflow-v1.schema.json",
  "format": "raider.portable-workflow", "version": "1.0", "limits": { "deadlineMs": 60000, "attempts": 3, "parallelism": 1, "children": 1, "tokens": 4000 },
  "schemas": { "inputs": { "request": { "type": "object", "properties": { "enabled": { "type": "boolean" } }, "required": ["enabled"], "additionalProperties": false } }, "outputs": { "text": { "type": "string" }, "verdict": { "type": "string" } } },
  "steps": [{ "id": "yes", "kind": "agent", "profile": "worker", "toolset": "read-only", "input": "#/inputs/request", "outputSchema": "text", "structuredOutput": true }, { "id": "no", "kind": "agent", "profile": "worker", "toolset": "read-only", "input": "#/inputs/request", "outputSchema": "text", "structuredOutput": true }, { "id": "branch", "kind": "conditional", "when": { "op": "isPresent", "value": "#/inputs/request/enabled" }, "then": "yes", "else": "no", "outputSchema": "text" }, { "id": "verify", "kind": "trustedCheck", "checkId": "branch-result", "registrySnapshot": "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "input": "#/steps/branch/output", "outputSchema": "verdict" }],
  "outputs": { "bindings": { "result": "#/steps/branch/output" }, "verdict": { "from": "#/steps/verify/output", "authority": "trustedVerifier" } }
}
