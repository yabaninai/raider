{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://raider.invalid/contracts/workflow-portable/workflow-v1.schema.json",
  "format": "raider.portable-workflow", "version": "1.0", "limits": { "deadlineMs": 60000, "attempts": 2, "parallelism": 1, "children": 0, "tokens": 2000 },
  "schemas": { "inputs": { "request": { "type": "string" } }, "outputs": { "text": { "type": "string" }, "verdict": { "type": "string" } } },
  "steps": [{ "id": "approval", "kind": "checkpoint", "checkpointRef": "review-before-write", "placement": "launchPolicy", "outputSchema": "text" }, { "id": "verify", "kind": "trustedCheck", "checkId": "post-approval-check", "registrySnapshot": "sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee", "input": "#/steps/approval/output", "outputSchema": "text" }],
  "outputs": { "bindings": { "result": "#/steps/approval/output" }, "verdict": { "from": "#/steps/verify/output", "authority": "trustedVerifier" } }
}
