{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://raider.invalid/contracts/workflow-portable/workflow-v1.schema.json",
  "format": "raider.portable-workflow", "version": "1.0", "limits": { "deadlineMs": 60000, "attempts": 3, "parallelism": 1, "children": 1, "tokens": 4000 },
  "schemas": { "inputs": { "request": { "type": "string" } }, "outputs": { "text": { "type": "string" }, "verdict": { "type": "string" } } },
  "steps": [{ "id": "draft", "kind": "agent", "profile": "worker", "toolset": "read-only", "input": "#/inputs/request", "outputSchema": "text", "structuredOutput": true }, { "id": "ordered", "kind": "sequence", "steps": ["draft", "verify"], "outputSchema": "text" }, { "id": "verify", "kind": "trustedCheck", "checkId": "format-check", "registrySnapshot": "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb", "input": "#/steps/draft/output", "outputSchema": "text" }],
  "outputs": { "bindings": { "result": "#/steps/ordered/output" }, "verdict": { "from": "#/steps/verify/output", "authority": "trustedVerifier" } }
}
