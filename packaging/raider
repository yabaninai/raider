#!/bin/sh
set -eu

HERE=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
JAR=${RAIDER_JAR:-"$HERE/raider-cli.jar"}
VERSION_FILE="$HERE/version"

if [ "${1:-}" = "--version" ] || [ "${1:-}" = "-V" ]; then
  if [ -r "$VERSION_FILE" ]; then
    VERSION=$(cat "$VERSION_FILE")
    printf 'raider %s\n' "$VERSION"
    exit 0
  fi
  printf '%s\n' 'raider: version metadata is missing' >&2
  exit 21
fi

if [ ! -r "$JAR" ]; then
  printf 'raider: distribution jar not found: %s\n' "$JAR" >&2
  exit 21
fi
if ! command -v java >/dev/null 2>&1; then
  printf '%s\n' 'raider: Java 21 or newer is required' >&2
  exit 21
fi

# The same artifact can be launched by Coursier without publishing a coordinate:
# cs launch --jar raider-cli.jar -- <raider arguments>.
if command -v cs >/dev/null 2>&1 && [ "${RAIDER_USE_COURSIER:-1}" = 1 ]; then
  exec cs launch --jar "$JAR" -- "$@"
fi
exec java -jar "$JAR" "$@"
